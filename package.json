{
  "name": "@zpi-dev/zpi-zread",
  "version": "0.1.0",
  "description": "AI 代码库文档生成器 — 基于 @zpi-dev/agent-sdk，一条命令把本地代码变成 Wiki 文档",
  "type": "module",
  "bin": {
    "zpi-zread": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node bin/cli.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@zpi-dev/agent-sdk": "0.1.63",
    "marked": "^15.0.7",
    "pinyin-pro": "^3.26.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.27.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1316151417/zpi-zread.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agent",
    "documentation",
    "wiki",
    "zread",
    "zpi"
  ],
  "license": "MIT"
}
